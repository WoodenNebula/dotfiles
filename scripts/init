# system update
yes | sudo pacman -Syu

# TODO: Source module wise dependency packages
# install main packages
yes | sudo pacman -S git base-devel zsh bat fzf stow bear less openssh zip unzip

# build yay
cd ~
git clone https://aur.archlinux.org/yay-bin.git
cd yay-bin
makepkg -si

# change shell to zsh
chsh -s $(where zsh)

# install ohmyzsh
cd ~
sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)"

stow zsh git alacritty nvim scripts tmux

# install nvim dependencies
yes | clang gdb lua51 python3 ruff shfmt stylua luarocks
